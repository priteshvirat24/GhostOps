# GhostOps Configuration
PROJECT_NAME="GhostOps"
ENVIRONMENT="development"
DEBUG=True

# API Server
API_HOST="0.0.0.0"
API_PORT=8000
CORS_ORIGINS=["http://localhost:3000", "http://127.0.0.1:3000"]

# CockroachDB Connection
# Local Docker CockroachDB standard connection:
DATABASE_URL="postgresql+psycopg://root@localhost:26257/ghostops?sslmode=disable"
# Docker network internal URL:
# DATABASE_URL="postgresql+psycopg://root@cockroachdb:26257/ghostops?sslmode=disable"

# AWS & Bedrock Configuration
AWS_REGION="us-east-1"
AWS_MOCK_MODE=True

# Bedrock Model Settings
BEDROCK_MODEL_ID="anthropic.claude-3-5-sonnet-20241022-v2:0"
BEDROCK_EMBEDDING_MODEL_ID="amazon.titan-embed-text-v1"

# Agent System Settings
AGENT_MAX_ITERATIONS=10
AUTO_APPROVE_SAFE_REMEDIATIONS=False
HUMAN_APPROVAL_REQUIRED=True

# Web Frontend
NEXT_PUBLIC_API_URL="http://localhost:8000"
